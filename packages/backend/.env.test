# Test Database Configuration
# Use a separate database for testing to avoid affecting development data
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/educational_notes_test?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/educational_notes_test?schema=public"

# JWT Secrets (test values)
JWT_SECRET="test-jwt-secret-key-do-not-use-in-production"

# Server Configuration
PORT=3001
NODE_ENV="test"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# Rate Limiting (more permissive for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
UPLOAD_DIR="./test-uploads"
MAX_FILE_SIZE=5242880

# Session
SESSION_TIMEOUT_STUDENT=86400000
SESSION_TIMEOUT_ADMIN=1800000

# Debug (set to true to see SQL queries in test output)
DEBUG_SQL=false

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/educational_notes?schema=public"

# JWT Secrets
JWT_SECRET="your-secret-key-change-in-production"

# Server Configuration
PORT=3001
NODE_ENV="development"

# Logging
# One of: fatal, error, warn, info, debug, trace, silent.
# Leave unset to use the per-environment default (debug in development,
# info in production, silent in test).
LOG_LEVEL="debug"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Session
SESSION_TIMEOUT_STUDENT=86400000
SESSION_TIMEOUT_ADMIN=1800000

# Protected PDF resource storage (must stay OUTSIDE any web-served directory)
RESOURCE_STORAGE_PATH="./storage/resources"
# Max resource upload size in bytes (25MB). Note: app.ts caps JSON bodies at
# 10mb, so the base64 upload path effectively allows ~7.5MB; use the raw
# application/pdf path for larger files.
RESOURCE_MAX_FILE_SIZE_BYTES=26214400
# Dedicated HMAC key for signed download URLs. Falls back to JWT_SECRET with a
# warning if unset. Set this so download links rotate independently of sessions.
RESOURCE_URL_SECRET=""
# Signed download URL lifetime in seconds (default 300, max 3600)
RESOURCE_URL_TTL_SECONDS=300
# External origin for absolute download URLs. Leave empty to return a relative
# path rather than trusting a client-supplied Host header.
PUBLIC_API_BASE_URL=""
